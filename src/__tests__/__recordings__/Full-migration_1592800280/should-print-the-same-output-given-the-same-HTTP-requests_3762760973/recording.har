                      "_key": "0478ca596e95fdcb15b70ca48ba9978b",
                      "_type": "crewMember",
                      "department": "Camera",
                      "externalCreditId": "556e6bbb925141157d00070f",
                      "externalId": 151,
                      "job": "Director of Photography",
                      "person": {
                        "_ref": "person_roger-deakins",
