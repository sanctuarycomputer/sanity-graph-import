                  "externalId": 353491,
                  "overview": [
                    {
                      "_key": "5f124ded4008b738f4cb1db94e9189e0",
                      "_type": "block",
                      "children": [
                        {
                          "_key": "rXoHiRLl",
                          "_type": "span",
                          "marks": [],
                          "text": "The last Gunslinger, Roland Deschain, has been locked in an eternal battle with Walter O’Dim, also known as the Man in Black, determined to prevent him from toppling the Dark Tower, which holds the universe together. With the fate of the worlds at stake, good and evil will collide in the ultimate battle as only Roland can defend the Tower from the Man in Black."
                        }
                      ],
                      "markDefs": [],
                      "style": "normal"
                    }
